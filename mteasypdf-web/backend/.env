# -------------------------------------------------------
# Autenticación JWT
# -------------------------------------------------------

# false = modo debug/desarrollo (sin validación JWT)
# true  = producción (requiere cookie mia_auth válida)
AUTH_ENABLED=true

# Secreto compartido con Herramientas Conexión — NUNCA subir al repositorio
JWT_SECRET=secretoenlamontana

JWT_ISSUER=suricato
JWT_AUDIENCE=mia

# URL de Herramientas Conexión para redirigir si el token es inválido
REDIRECT_ON_FAILURE=https://app.grupohemac.com.mx:3003/select-platform

# -------------------------------------------------------
# Almacenamiento
# -------------------------------------------------------
STORAGE_DIR=C:/mteasypdf_jobs

# Límite máximo de carga por archivo (en MB)
MAX_UPLOAD_SIZE_MB=3072
